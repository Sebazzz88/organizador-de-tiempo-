<?xml version="1.0" encoding="utf-8"?>
<!-- La página nueva entra deslizándose desde la derecha y apareciendo. El widget exige un solo ObjectAnimator. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="380"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <propertyValuesHolder android:propertyName="alpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType" />
    <propertyValuesHolder android:propertyName="translationX" android:valueFrom="60" android:valueTo="0" android:valueType="floatType" />
</objectAnimator>
