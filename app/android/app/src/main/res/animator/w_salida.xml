<?xml version="1.0" encoding="utf-8"?>
<!-- La página anterior sale hacia la izquierda y se desvanece. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="320"
    android:interpolator="@android:interpolator/accelerate_cubic">
    <propertyValuesHolder android:propertyName="alpha" android:valueFrom="1" android:valueTo="0" android:valueType="floatType" />
    <propertyValuesHolder android:propertyName="translationX" android:valueFrom="0" android:valueTo="-60" android:valueType="floatType" />
</objectAnimator>
