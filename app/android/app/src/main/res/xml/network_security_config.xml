<?xml version="1.0" encoding="utf-8"?>
<!-- Solo conexiones cifradas (HTTPS) y solo con certificados del sistema, no los instalados por el usuario. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
